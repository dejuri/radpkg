[package]
name = "obs-studio"
version = "32.2.2"
description = "OBS Studio - Free and open source software for live streaming and screen recording"
source = "https://github.com/obsproject/obs-studio/releases/download/32.2.2/OBS-Studio-32.2.2-Sources.tar.gz"

[build]
system = "manual"
build_commands = [
	"rm -rf build",
	"find . -type f \\( -name 'CMakeLists.txt' -o -name '*.cmake' \\) -exec sed -i 's/CMAKE_CXX_STANDARD 17/CMAKE_CXX_STANDARD 20/g; s/CMAKE_CXX_STANDARD 14/CMAKE_CXX_STANDARD 20/g; s/-std=c++17/-std=c++20/g' {} +",
	"cmake -S . --preset ubuntu -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=20 -DCMAKE_CXX_STANDARD_REQUIRED=ON -DCMAKE_DISABLE_FIND_PACKAGE_websocketpp=ON -DCMAKE_IGNORE_PATH=/usr/include/websocketpp -DCMAKE_INSTALL_PREFIX=/usr -DENABLE_BROWSER=ON -DCEF_ROOT_DIR=/opt/cef -DENABLE_VIRTUALCAM=ON -DENABLE_AJA=OFF -DENABLE_WEBSOCKET=ON",
	"find build -type f -name 'flags.make' -exec sed -i 's/-std=c++17/-std=c++20/g; s/-std=gnu++17/-std=gnu++20/g' {} +",
	"cmake --build build -j$RAD_CORES"
]
install_command = "cmake --install build"
depends = "qtbase,qtsvg,simde,uthash,swig,v4l-utils,cef-bin,nlohmann_json,srt,librist,mbedtls,libvpl,libdatachannel,qr-code-generator,dev-cpp/asio"
